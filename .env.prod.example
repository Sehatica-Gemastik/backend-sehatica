# Database (Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/sehatica-db?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
FRONTEND_URL=https://YOUR-WEB.vercel.app

# LLM
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=

# RDSA smart notifications
RDSA_SOFTMAX_TEMPERATURE=0.35
RDSA_RECENCY_HALF_LIFE_DAYS=3
RDSA_MAX_ASKS_PER_DAY=5
RDSA_QUIET_HOURS_START=22
RDSA_QUIET_HOURS_END=6
