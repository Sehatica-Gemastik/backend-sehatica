{
  "name": "backend-sehatica",
  "license": "MIT",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "dev:prod": "bun --env-file=.env.prod run --hot src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:push:prod": "bun --env-file=.env.prod drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:studio:prod": "bun --env-file=.env.prod drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "postgres": "^3.4.9",
    "unpdf": "^1.8.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "5.9.3"
  }
}