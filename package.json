{
  "name": "backend-sehatica",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "db:generate": "bun node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "bun node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "bun node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "bun node_modules/drizzle-kit/bin.cjs studio",
    "doctor:create": "bun scripts/create-doctor.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "~6.0.3"
  }
