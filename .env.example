DATABASE_URL=postgres://postgres:postgres@localhost:5432/sehatica
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000

# ── LLM (production-shaped; default dummy for local)
# dummy | gemini | openai | anthropic
LLM_PROVIDER=dummy
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_OUTPUT_TOKENS=2048
LLM_RATE_LIMIT_PER_MINUTE=20

# Provider-specific keys (wired; unused when provider=dummy)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Heally / RDSA
RDSA_SOFTMAX_TEMPERATURE=0.35
RDSA_RECENCY_HALF_LIFE_DAYS=3
HEALLY_MAX_ASKS_PER_DAY=5
HEALLY_QUIET_HOURS_START=22
HEALLY_QUIET_HOURS_END=6
