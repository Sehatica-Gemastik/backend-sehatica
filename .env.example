# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sehatica
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000

# LLM — dummy (lokal tanpa key) | groq (vision rekam medis)
LLM_PROVIDER=dummy
LLM_API_KEY=
LLM_MODEL=qwen/qwen3-32b
LLM_PRIVACY_SANITIZE=true

# RDSA smart notifications (no LLM, no chat)
RDSA_SOFTMAX_TEMPERATURE=0.35
RDSA_RECENCY_HALF_LIFE_DAYS=3
RDSA_MAX_ASKS_PER_DAY=5
RDSA_QUIET_HOURS_START=22
RDSA_QUIET_HOURS_END=6
